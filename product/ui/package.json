{
  "name": "graf-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "format:check": "prettier --check src vite.config.ts"
  },
  "dependencies": {
    "@cosmograph/cosmograph": "2.5.1",
    "@duckdb/duckdb-wasm": "1.32.0",
    "apache-arrow": "17.0.0",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.5.2",
    "jsdom": "25.0.1",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.5.2",
    "svelte-check": "4.7.6",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
